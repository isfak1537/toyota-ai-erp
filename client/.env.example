# Build-time settings of the client (Vite). Copy to .env.local for development; on Vercel set them in the project's
# Environment Variables. Nothing here is a secret: everything prefixed VITE_ ends up in the public JavaScript.

# Base URL of the ERP API, without /api/v1 and without a trailing slash.
# Leave empty in development: the dev server proxies /api to VITE_DEV_API (below).
# In production set it, for example, to https://your-erp-api.vercel.app
VITE_API_URL=

# Development only: where the dev server forwards /api (default http://localhost:5001)
VITE_DEV_API=http://localhost:5001
