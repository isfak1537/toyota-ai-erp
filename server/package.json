{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand --selectProjects unit integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "seed:synthetic": "node prisma/seed/generate.js",
    "reconcile": "node scripts/reconcile.js",
    "seed:users": "node scripts/seed-users.js",
    "seed:export-fixtures": "node scripts/export-fixtures.js",
    "test:live": "jest --selectProjects live",
    "test:loop": "bash scripts/test-loop.sh",
    "demo:prepare": "node scripts/demo.js prepare",
    "demo:undo": "node scripts/demo.js undo"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/tests/setup/global-setup.js",
        "setupFiles": [
          "<rootDir>/tests/setup/env.js"
        ],
        "testTimeout": 30000
      },
      {
        "displayName": "live",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/live/**/*.test.js"
        ],
        "testTimeout": 60000
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
