# Server
PORT=5001
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toyota_erp?schema=public

# Integration tests (a separate local database whose name ends in _test;
# tests abort if this equals DATABASE_URL)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toyota_erp_test?schema=public

# Auth (JWT_SECRET: at least 32 random characters)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Demo users for `npm run seed:users` (each at least 12 characters)
DEMO_ADMIN_PASSWORD=
DEMO_WAREHOUSE_PASSWORD=
DEMO_PROCUREMENT_PASSWORD=
DEMO_VIEWER_PASSWORD=

# AI service (the Python service in ../ai-service); the secret must equal its AI_SERVICE_SECRET
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=
AI_TIMEOUT_MS=15000
AI_TRAIN_TIMEOUT_MS=120000

# Replenishment (AI-004); both are stored with every suggestion
REPLEN_Z=1.65
REPLEN_REVIEW_DAYS=7
