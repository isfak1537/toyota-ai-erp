# Server
PORT=5001
# Browser origin(s) allowed to call the API: one URL, or several separated by commas (production + preview)
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toyota_erp?schema=public
# Hosted database (Neon): DATABASE_URL is the POOLED url (host contains -pooler) used by the running API;
# DIRECT_DATABASE_URL is the direct url used only by `prisma migrate deploy`. Leave it empty locally.
DIRECT_DATABASE_URL=
# Connections per server process (default 10). Use 1-3 on a serverless host.
DB_POOL_MAX=
# Behind a proxy (Vercel, Render) set 1 so each client has its own login-attempt budget. Never on a bare server.
TRUST_PROXY=

# Integration tests (a separate local database whose name ends in _test;
# tests abort if this equals DATABASE_URL)
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/toyota_erp_test?schema=public

# Auth (JWT_SECRET: at least 32 random characters)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Demo users for `npm run seed:users` (each at least 12 characters)
DEMO_ADMIN_PASSWORD=
DEMO_WAREHOUSE_PASSWORD=
DEMO_PROCUREMENT_PASSWORD=
DEMO_VIEWER_PASSWORD=

# AI service (the Python service in ../ai-service); the secret must equal its AI_SERVICE_SECRET
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=
# Plain http to a non-local AI service is refused (the secret would travel in clear). true only for a trusted private network.
AI_ALLOW_PLAIN_HTTP=
AI_TIMEOUT_MS=15000
AI_TRAIN_TIMEOUT_MS=120000

# Replenishment (AI-004); both are stored with every suggestion
REPLEN_Z=1.65
REPLEN_REVIEW_DAYS=7

# LLM explanations and assistant (leave LLM_PROVIDER empty to switch the LLM off)
# LLM_PROVIDER: groq | gemini | ollama. Tool calling (needed by the assistant) is verified for openai/gpt-oss-20b and 120b on Groq.
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_MS=15000
LLM_RATE_PER_MINUTE=20
LLM_RATE_PER_DAY=800
