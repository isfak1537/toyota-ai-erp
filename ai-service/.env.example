# Copy to .env (never commit .env). Documented values only.

# Read-only database role (see sql/create_ai_readonly_role.sql)
AI_DB_URL=postgresql://ai_readonly:CHANGE_ME@localhost:5432/toyota_erp

# Shared secret between the ERP API and this service (header X-AI-Service-Secret).
# At least 16 characters; the service refuses to start without it.
AI_SERVICE_SECRET=change-me-to-a-long-random-string

# Where trained models are stored (gitignored)
AI_MODEL_DIR=models

# Business time zone offset in hours (Asia/Dhaka = UTC+6). Daily buckets and the
# business-hours rule use it; it must match the seed data (CLAUDE.md).
AI_TZ_OFFSET_HOURS=6
